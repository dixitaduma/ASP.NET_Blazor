@inject MessagingApp.Services.IConversationService ConversationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="conversation-list">
    <div class="conversation-header">
        <div class="header-left">
            <h5>Conversations</h5>
            <small class="sub">Recent chats &amp; activity</small>
        </div>

        <div class="header-actions">
            <input class="search" placeholder="Search conversations..." @oninput="OnSearch" />

            <button class="btn btn-new" @onclick="StartNewConversation" title="Start new conversation">
                <span class="bi bi-plus-circle"></span>
                <span class="label">New</span>
            </button>
        </div>
    </div>

    <div class="conversation-items" role="list">
        @if (filteredConversations.Count == 0)
        {
            <div class="no-conversations">
                <div class="icon">💬</div>
                <p>No conversations yet</p>
                <small>Start a new conversation to begin chatting</small>
            </div>
        }
        else
        {
            @foreach (var conversation in filteredConversations)
            {
                <div class="conversation-item @(IsActiveConversation(conversation.Id) ? "active" : "")"
                     role="listitem"
                     @onclick="() => SelectConversation(conversation)">
                    <div class="left-col">
                        <div class="avatar">@GetAvatarInitials(conversation.UserName)</div>
                    </div>

                    <div class="center-col">
                        <div class="conversation-title">@conversation.Title</div>
                        <div class="conversation-preview">@GetLastMessagePreview(conversation)</div>
                    </div>

                    <div class="right-col">
                        <div class="conversation-meta">
                            <span class="conversation-time">@FormatTime(conversation.LastMessageAt)</span>
                            @if (HasUnread(conversation))
                            {
                                <span class="unread-badge">New</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<MessagingApp.Models.Conversation> conversations = new();
    private List<MessagingApp.Models.Conversation> filteredConversations = new();
    private string? currentConversationId;
    private string searchTerm = string.Empty;

    protected override void OnInitialized()
    {
        // Subscribe for real-time updates
        ConversationService.ConversationsChanged += OnConversationsChanged;
        LoadConversations();
    }

    protected override void OnParametersSet()
    {
        LoadConversations();
    }

    private void OnConversationsChanged()
    {
        // Ensure UI update happens on the correct sync context
        InvokeAsync(() => LoadConversations());
    }

    private void LoadConversations()
    {
        conversations = ConversationService.GetAllConversations();
        ApplyFilter();
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredConversations = conversations;
        }
        else
        {
            var t = searchTerm.Trim().ToLowerInvariant();
            filteredConversations = conversations
                .Where(c => c.Title.ToLowerInvariant().Contains(t) || c.UserName.ToLowerInvariant().Contains(t) ||
                            (c.Messages.LastOrDefault()?.Text ?? string.Empty).ToLowerInvariant().Contains(t))
                .ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm = e?.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void SelectConversation(MessagingApp.Models.Conversation conversation)
    {
        currentConversationId = conversation.Id;
        var url = $"/messaging?name={Uri.EscapeDataString(conversation.UserName)}&conversationId={conversation.Id}";
        NavigationManager.NavigateTo(url);
    }

    private void StartNewConversation()
    {
        NavigationManager.NavigateTo("/username");
    }

    private bool IsActiveConversation(string conversationId)
    {
        return currentConversationId == conversationId;
    }

    private string FormatTime(DateTime dateTime)
    {
        var now = DateTime.Now;
        var diff = now - dateTime;

        if (diff.TotalMinutes < 1)
            return "Just now";
        else if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}m";
        else if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h";
        else if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}d";
        else
            return dateTime.ToString("MMM dd");
    }

    private string GetLastMessagePreview(MessagingApp.Models.Conversation conversation)
    {
        var lastMessage = conversation.Messages.LastOrDefault();
        if (lastMessage == null)
            return "No messages yet";

        var preview = lastMessage.Text;
        if (preview.Length > 60)
            preview = preview.Substring(0, 60) + "...";

        return preview;
    }

    private string GetAvatarInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }

    private bool HasUnread(MessagingApp.Models.Conversation conversation)
    {
        // Simple heuristic: unread if last message is not from user
        var last = conversation.Messages.LastOrDefault();
        return last != null && !last.IsFromUser;
    }

    public void Dispose()
    {
        ConversationService.ConversationsChanged -= OnConversationsChanged;
    }
}

<style>
    .conversation-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 14px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        border-radius: 12px;
        box-shadow: 0 6px 24px rgba(40, 44, 63, 0.08);
        max-height: 72vh;
        overflow: hidden;
        font-family: "Segoe UI", Roboto, system-ui, -apple-system, "Helvetica Neue", Arial;
    }

    .conversation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #eef2f6;
    }

    .header-left h5 {
        margin: 0;
        color: #1f2d4d;
        font-weight: 700;
        font-size: 1.02rem;
        letter-spacing: -0.2px;
    }

    .header-left .sub {
        display: block;
        color: #6b7280;
        font-size: 0.78rem;
        margin-top: 2px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .search {
        padding: 8px 12px;
        border-radius: 10px;
        border: 1px solid #e6eef6;
        background: #f7fbff;
        min-width: 180px;
        outline: none;
        transition: box-shadow 0.15s ease, transform 0.12s ease;
    }

    .search:focus {
        box-shadow: 0 6px 18px rgba(102, 126, 234, 0.12);
        transform: translateY(-1px);
    }

    .btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 10px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        border: none;
        cursor: pointer;
        font-weight: 600;
        box-shadow: 0 6px 16px rgba(118, 75, 162, 0.14);
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .btn-new .label {
        display: none;
    }

    .btn-new:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.18);
    }

    @media (min-width: 720px) {
        .btn-new .label { display: inline; }
    }

    .conversation-items {
        flex: 1;
        overflow-y: auto;
        padding-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .conversation-item {
        display: grid;
        grid-template-columns: 48px 1fr 84px;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border-radius: 10px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
    }

    .conversation-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(36, 41, 60, 0.06);
        border-color: #e6eef6;
    }

    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f1f5ff, #eef2ff);
        color: #1f2937;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: inset 0 -6px 12px rgba(118, 75, 162, 0.02);
    }

    .conversation-title {
        font-weight: 700;
        color: #0f1724;
        font-size: 0.95rem;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-preview {
        color: #51607a;
        font-size: 0.85rem;
        line-height: 1.2;
        overflow: hidden;
        max-height: 2.4em;
        text-overflow: ellipsis;
    }

    .right-col {
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }

    .conversation-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
    }

    .conversation-time {
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .unread-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        background: linear-gradient(90deg, #ff7a7a, #ff4d6d);
        color: #fff;
        font-weight: 700;
        font-size: 0.72rem;
        box-shadow: 0 6px 12px rgba(255, 77, 109, 0.15);
    }

    .conversation-item.active {
        background: linear-gradient(135deg, rgba(102,126,234,0.12), rgba(118,75,162,0.06));
        border-color: rgba(102,126,234,0.18);
        box-shadow: 0 12px 36px rgba(102,126,234,0.06);
    }

    .no-conversations {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: center;
        justify-content: center;
        padding: 32px 8px;
        color: #64748b;
    }

    .no-conversations .icon {
        font-size: 2.4rem;
    }

    .conversation-items::-webkit-scrollbar {
        width: 8px;
    }
    .conversation-items::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg,#cbd5e1,#94a3b8);
        border-radius: 999px;
    }
    .conversation-items::-webkit-scrollbar-track {
        background: transparent;
    }
</style>
